# Safe local default. Production must opt in to MainNet explicitly.
ROUNDWATCH_NETWORK=testnet

AVM_ADDRESS=
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Required on MainNet. Used for the explicit x402 resource URL advertised to clients.
ROUNDWATCH_PUBLIC_BASE_URL=

# Optional override. When omitted, the selected network's AlgoNode Indexer is used.
ALGORAND_INDEXER_URL=

# Local TestNet default. On MainNet this MUST be an absolute path on a mounted persistent volume,
# for example /data/roundwatch.sqlite.
ROUNDWATCH_DB_PATH=data/roundwatch.sqlite
ROUNDWATCH_POLL_INTERVAL_MS=5000
ROUNDWATCH_RECONCILE_INTERVAL_MS=5000
# Shared finite Indexer budget. These are tuning values, not an SLA.
ROUNDWATCH_INDEXER_REQUESTS_PER_SECOND=4
ROUNDWATCH_INDEXER_BURST=4
ROUNDWATCH_INDEXER_CONCURRENCY=2
ROUNDWATCH_SCAN_ROUND_WINDOW=100
# Bounded process-local LRU of validated historical scan pages.
# Set to 0 to disable cross-sweep reuse while preserving per-sweep deduplication.
ROUNDWATCH_SCAN_PAGE_CACHE_ENTRIES=16
# Maximum serialized validated page payload retained across sweeps.
# Entry and byte limits are both enforced; 0 disables cross-sweep retention.
ROUNDWATCH_SCAN_PAGE_CACHE_BYTES=8388608
# Production scan strategy. C = sender + asset + rounds + exact amount +
# note-prefix when invoiceNote is present. Set A for immediate rollback.
ROUNDWATCH_SCAN_QUERY_VARIANT=C

# Pre-settlement protection. Applies only when PAYMENT-SIGNATURE is present.
# Bounds free facilitator verification work without throttling ordinary 402 discovery.
ROUNDWATCH_SIGNED_PAYMENT_REQUESTS_PER_SECOND=10
ROUNDWATCH_SIGNED_PAYMENT_BURST=20
ROUNDWATCH_SIGNED_PAYMENT_CONCURRENCY=4

# Readiness fails closed when the database filesystem has less free space than
# this threshold. Paid watch admission is refused while readiness is red.
ROUNDWATCH_MIN_FREE_DISK_BYTES=67108864

# Challenge-release policy. These values are server-controlled, not request fields.
ROUNDWATCH_WATCH_TTL_MS=1800000
ROUNDWATCH_MAX_OPEN_WATCHES=50
ROUNDWATCH_MAX_OPEN_WATCHES_PER_PAYER=5
# Hard cap on durable background service turns consumed by one purchased watch.
# Exhaustion is terminal state=indeterminate, reason=work_budget_exhausted.
ROUNDWATCH_WORK_UNIT_BUDGET=500

# TestNet-only live crash-window proof. NEVER enable on MainNet.
# When set to 1, the server exits with code 86 after confirmed x402 settlement
# and before the SQLite activation commit. Restart with this unset/0 so the
# reconciliation worker can recover the pending watch from on-chain evidence.
ROUNDWATCH_TESTNET_EXIT_AFTER_SETTLE=0

# Optional platform-provided HTTP port. Defaults to 4021 locally.
PORT=4021

# MainNet example (do not paste private keys or mnemonics here):
# ROUNDWATCH_NETWORK=mainnet
# AVM_ADDRESS=<public Algorand MainNet receiver address>
# FACILITATOR_URL=https://facilitator.goplausible.xyz
# ROUNDWATCH_PUBLIC_BASE_URL=https://roundwatch-api.onrender.com
# ALGORAND_INDEXER_URL=https://mainnet-idx.algonode.cloud
# ROUNDWATCH_DB_PATH=/data/roundwatch.sqlite
# ROUNDWATCH_WATCH_TTL_MS=1800000
# ROUNDWATCH_MAX_OPEN_WATCHES=50
# ROUNDWATCH_MAX_OPEN_WATCHES_PER_PAYER=5
# ROUNDWATCH_WORK_UNIT_BUDGET=500
# ROUNDWATCH_INDEXER_REQUESTS_PER_SECOND=4
# ROUNDWATCH_INDEXER_BURST=4
# ROUNDWATCH_INDEXER_CONCURRENCY=2
# ROUNDWATCH_SCAN_ROUND_WINDOW=100
# ROUNDWATCH_SCAN_PAGE_CACHE_ENTRIES=16
# ROUNDWATCH_SCAN_PAGE_CACHE_BYTES=8388608
# ROUNDWATCH_SCAN_QUERY_VARIANT=C
# ROUNDWATCH_SIGNED_PAYMENT_REQUESTS_PER_SECOND=10
# ROUNDWATCH_SIGNED_PAYMENT_BURST=20
# ROUNDWATCH_SIGNED_PAYMENT_CONCURRENCY=4
# ROUNDWATCH_MIN_FREE_DISK_BYTES=67108864
# ROUNDWATCH_TESTNET_EXIT_AFTER_SETTLE=0
# PORT=4021

# Optional economics instrumentation. Emits aggregate, privacy-safe terminal
# watch metrics to logs. Does not alter pricing, polling, or matching behavior.
# ROUNDWATCH_ECONOMICS_METRICS=0
# Sampling cadence when economics instrumentation is enabled.
# ROUNDWATCH_ECONOMICS_SAMPLE_INTERVAL_MS=60000
